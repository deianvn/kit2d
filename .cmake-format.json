{
    "format": {
        "tab_size": 4,
        "line_width": 100,
        "use_tabchars": false,
        "min_prefix_chars": 4,
        "max_prefix_chars": 4,
        "command_case": "unchanged",
        "keyword_case": "unchanged",
        "enable_sort": false,
        "autosort": false
    },
    "markup": {
        "enable_markup": false,
        "first_comment_is_literal": true
    }
}
